# Per-install configuration, generated by install/index.php — never shared.
/config.php

# Uploaded gallery images/thumbnails — runtime content, not source.
/albums/*
!/albums/.gitkeep

# Uploaded category/album cover images — runtime content, not source.
/covers/categories/*
!/covers/categories/.gitkeep
/covers/albums/*
!/covers/albums/.gitkeep

# Update-system cache (downloads, extracts, backups, logs) — keep only the
# tracked directory-protection stub files, everything else is runtime data.
/cache/*
!/cache/.updates
/cache/.updates/*
!/cache/.updates/.htaccess
!/cache/.updates/index.html

# OS / editor cruft.
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/
